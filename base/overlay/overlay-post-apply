#!/usr/bin/env bash
# overlay-post-apply
# Injects dynamic values into the rootfs that cannot be known at overlay build time.
# Runs once inside arch-chroot immediately after the overlay is copied.
# Self-deletes after execution so it does not appear in the final image.

# 1. Detect the kernel version from installed modules
kernver=$(ls /usr/lib/modules/ | sort -V | tail -1)
if [ -n "$kernver" ]; then
    # 2. Generate mkinitcpio preset with the real kernel version pinned
    #    The static preset in the overlay omits ALL_kver for this reason.
    cat >/etc/mkinitcpio.d/linux-nabu.preset <<PRESET
# mkinitcpio preset file for the 'linux-nabu' package

ALL_kver="$kernver"

PRESETS=('default')

default_uki="/boot/efi/EFI/arch/arch-linux-nabu.efi"
default_cmdline="/etc/cmdline.d/root.conf"
PRESET

    # 3. Point ukify's DeviceTree to the real dtb path, which includes version
    sed -i "s|^DeviceTree=.*|DeviceTree=/boot/dtb-${kernver}|" /usr/lib/kernel/uki.conf
fi

# 4. Prevent pacman from overwriting the custom nabu kernel on upgrade
#    linux-nabu and linux-nabu-headers are built with custom config/signing
#    and must not be replaced by upstream packages.
sed -i '/^IgnorePkg/d' /etc/pacman.conf
if grep -q '^#IgnorePkg' /etc/pacman.conf; then
    sed -i '/^#IgnorePkg/c\IgnorePkg = linux-nabu linux-nabu-headers' /etc/pacman.conf
else
    sed -i '/^\[options\]/a\IgnorePkg = linux-nabu linux-nabu-headers' /etc/pacman.conf
fi
